# KVC manual test configuration.
#
# Copy this file to kvc_test.env and edit the values for the target server:
#   cp kvc_test.env.example kvc_test.env
#   vi kvc_test.env
# Or run: ./qa_run.sh init
#
# Everything here is optional except MODEL_PATH / MODEL_NAME / images;
# qa_run.sh doctor validates the final configuration.

# ---------------------------------------------------------------------------
# Benchmark source (for AISBench v2 code; can be any path on the target)
# ---------------------------------------------------------------------------
BENCH_SOURCE_DIR=/path/to/benchmark

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
MODEL_PATH=/path/to/model
TOKENIZER_PATH=                 # default: MODEL_PATH
MODEL_NAME=my-model             # must match the served model name
MAX_MODEL_LEN=32768
CHAT_API=true                   # true: /v1/chat/completions; false: /v1/completions
TP_SIZE=1
CARD=0                          # single card; ignored when CARDS is set
CARDS=                          # e.g. 0,1 for TP=2 (optional)
GPU_MEM_UTIL=0.85
ENGINE_START_TIMEOUT=300

# ---------------------------------------------------------------------------
# Images (docker save/load the same tags on the target server)
# ---------------------------------------------------------------------------
ENGINE_IMAGE=agenthint-vllm:0.1.0-p3memcache
MOTOR_IMAGE=mindie-motor-vllm:e2e3b
AIS_IMAGE=ais-runner:ais-1

# ---------------------------------------------------------------------------
# Motor installation
#   image  : Motor is already inside MOTOR_IMAGE (recommended delivery mode)
#   wheel  : install MOTOR_WHEEL into the Motor container
#   source : build MOTOR_SOURCE_DIR with build.sh (needs Rust/libzmq/g++)
# ---------------------------------------------------------------------------
MOTOR_INSTALL_MODE=image
MOTOR_WHEEL=
MOTOR_SOURCE_DIR=

# ---------------------------------------------------------------------------
# Paths (container and host use the same absolute paths)
# ---------------------------------------------------------------------------
WORK_DIR=/opt/kvcfunc
DATA_DIR=$WORK_DIR/data
RESULTS_DIR=$WORK_DIR/results
GENERATED_CONFIG_DIR=$WORK_DIR/generated_configs

# ---------------------------------------------------------------------------
# Ports (choose free ports on the target server)
# ---------------------------------------------------------------------------
ENGINE_PORT=18000
MOTOR_INFER_PORT=19125
MOTOR_MGMT_PORT=19126
MOTOR_OBS_PORT=19127
MMC_META_PORT=15000
MMC_STORE_PORT=16000
MMC_METRICS_PORT=18181
MMC_LOOKUP_PORT=19100

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
HOST_IP=127.0.0.1
DOCKER_BIN=docker
KVC_CONTAINER_PREFIX=kvcfunc
AIS_RUN_MODE=docker             # docker | host
AIS_PRE_CMD="pip uninstall -y av >/dev/null 2>&1 || true"
ENGINE_TOOL_ARGS="--enable-auto-tool-choice --tool-call-parser hermes"
ENGINE_EXTRA_ARGS=
MEMCACHE_LIB_DIR=/usr/local/python3.12.13/lib/python3.12/site-packages/memcache_hybrid/lib
PYTHON_LIB_DIR=/usr/local/python3.12.13/lib
KVC_TEST_ENV_FILE=

# ---------------------------------------------------------------------------
# Test data
#   synthetic: generate deterministic long prompts with the model tokenizer
#   legacy   : use SWE-bench-derived JSONL from SOURCE_DATA_DIR
#   external : use pre-built JSONL already present in DATA_DIR
# ---------------------------------------------------------------------------
KVC_DATA_MODE=synthetic
SOURCE_DATA_DIR=
FAST_IDLE_OFFLOAD=10
FAST_DELAY_MS=15000
FAST_S1_DURATION=120
FAST_S5_DURATION=180
STD_IDLE_OFFLOAD=30
STD_DELAY_MS=45000
STD_S1_DURATION=180
STD_S5_DURATION=300

# ---------------------------------------------------------------------------
# Ascend / MemCache
# ---------------------------------------------------------------------------
ASCEND_DRIVER_PATH=/usr/local/Ascend/driver
ASCEND_INSTALL_INFO=/etc/ascend_install.info
ASCEND_DCMI=/usr/local/dcmi
ASCEND_SET_ENV=/usr/local/Ascend/ascend-toolkit/set_env.sh
MMC_WORLD_SIZE=1
MMC_DRAM_SIZE=64GB
MMC_MAX_DRAM_SIZE=256GB
NUM_CACHE_LEVELS=2
KVC_SHM_KEY=kvcfunc
KVC_METRICS_SHM_NAME=motor_kvc_metrics_kvcfunc

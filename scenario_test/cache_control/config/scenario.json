{
  "name": "cache_control_short_pause",
  "description": "短 pause（60s）+ agent hint（header cache_control）收益验证。每个会话 8 次调用 = 1 冷启 + 7 resume；pause 60s；prompt 8448 token = 66 块。三种形态：clean（干净引擎）/ churn（干净引擎 + 受控外部冷流量）/ mixed（同引擎先跑 hint 再跑 off）。",
  "forms": {
    "clean": {
      "desc": "每臂前重启引擎；回答「hint 本身是加速还是开销」。池子装得下且无外部压力时，off 靠自然 LRU 就能命中 ⇒ hint 是纯开销。",
      "restart": "per_arm",
      "v9": "enforce",
      "v10_v11": "skip"
    },
    "churn": {
      "desc": "干净引擎 + 受控外部 churn（一次性冷流量，永不命中、无保护声明）。回答「共享引擎有淘汰压力时，hint 能否保住本会话前缀」。正收益的主证据形态：每轮重启引擎，两臂都可验收。",
      "restart": "per_round",
      "v9": "enforce",
      "v10_v11": "enforce"
    },
    "mixed": {
      "desc": "同一引擎进程先跑 decl、不重启接着跑 off（生产混部形态）。off 的基线被人为劣化，不能作为干净对照；仅作生产形态参考，不参与正收益主结论。",
      "restart": "never",
      "v9": "expected_fail",
      "v10_v11": "skip"
    }
  },
  "dataset": {
    "prefix": "contend_sp7_p60",
    "churn_prefix": "contend_sp7churn_p60",
    "source": "data/source/contend_lru60_S32.jsonl",
    "generated_dir": "data/generated",
    "sessions_allowed": [

  "matrix_notes": {
    "clean": "形态 A：干净引擎基线。装得下且无外部压力时 off 也能命中 ⇒ decl 是纯开销。",
    "churn": "形态 C：正收益主证据。L2（≈22.7 块/s）是推荐工作点；churn×pause ≫ 可牺牲区 ⇒ off 必丢、decl 受保护。",
    "mixed": "形态 B：生产混部参考。decl 后不重启直接 off，off 基线被劣化（V9 预期 FAIL），只作会话级优势的参考。",
    "S1": "反常点（hint 反向劣化），只用于边界验证，不纳入日常矩阵",
    "169_S32": "64GB 卡容量边界点：需求 2112 / 池 2031 = 1.04，靠容量而非外部 churn 让 off 丢前缀"
  },
  "acceptance": {
    "comment": "唯一事实源：07_verify.py 直接读取本段。form 相关开关见 forms.*。",
    "V1_arm_selfcheck": true,
    "V2_http_errors_zero": true,
    "V3_hint_sent_matches_arm": true,
    "V4_prefix_cache_reset_200": true,
    "V5_pool_matches_env": true,
    "V6_coordinator_pid_stable": true,
    "V7_identity_hits_plus_prefill_eq_queries": true,
    "V8_reuse_blocks_sane": true,
    "V9_off_baseline_clean": true,
    "V10_pressure_effective": true,
    "V11_benefit_realized": true,
    "half_threshold": "le500 >= 50% of infer requests  <=>  p50 <= 500ms"
  },
  "isolation": {
    "engine_restart": "per_form",
    "comment": "干净/ churn 形态：切臂与每轮都重启引擎（per_round 更严）；mixed 形态：刻意不重启（生产混部）。off 轮若发现同引擎有 hint 历史，clean/churn 会自动强制重启。污染原因：会话注册表累积/受保护块占窗口/空闲计数虚高，reset_prefix_cache 清不掉，只有重启进程能恢复。",
    "engine_restart_note": "重启必须 SIGKILL 所有 VLLM 进程（含 setproctitle 改名后的 VLLM::EngineCore）并等待 HBM 释放，见 docs/TROUBLESHOOTING.md"
  },
